---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const { name, description, icon, links } = project.data;
const orderedLinks = links.toSorted((a, b) => Number(a.kind === 'app') - Number(b.kind === 'app'));
---

<article class="project-card flex flex-col">
  <div class="card-heading flex items-center">
    <Image src={icon} alt="" width={48} height={48} class="project-icon" loading="eager" />
    <h3>{name}</h3>
  </div>
  <p class="description">{description}</p>
  <div class="card-actions flex flex-wrap items-center">
    {orderedLinks.map((link) => (
      <a class={link.kind === 'app' ? 'app-link' : 'github-link'} href={link.url} aria-label={`${link.label} — ${name}`}>
        {link.kind === 'github' && <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.15c-3.1.67-3.75-1.32-3.75-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15 1 .1.85 2.15 3.24 1.1.1-.72.39-1.2.71-1.48-2.47-.28-5.07-1.24-5.07-5.49 0-1.21.43-2.2 1.14-2.98-.12-.28-.5-1.41.11-2.94 0 0 .94-.3 3.06 1.14A10.7 10.7 0 0 1 12 6.35c.94 0 1.88.13 2.76.37 2.12-1.44 3.05-1.14 3.05-1.14.61 1.53.23 2.66.11 2.94.71.78 1.14 1.77 1.14 2.98 0 4.26-2.6 5.2-5.08 5.48.4.35.75 1.02.75 2.06V22c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z"/></svg>}
        <span>{link.label}</span>
        {link.kind === 'app' && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>}
      </a>
    ))}
  </div>
</article>
